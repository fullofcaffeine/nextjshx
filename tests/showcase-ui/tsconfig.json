{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    ".tmp/**/*.ts",
    ".tmp/**/*.tsx"
  ]
}
