{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    ".tmp/typescript/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
