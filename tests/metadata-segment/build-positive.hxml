-lib genes-ts
-cp src
-cp tests/metadata-segment/src
-main metadata_segment.NoRuntime
-js tests/metadata-segment/.tmp/application.js
--no-output
-D genes.ts
-D genes.ts.no_extension
-D nextjshx.app-root=tests/metadata-segment/next-app/app
-D nextjshx.generated-root=tests/metadata-segment/.tmp/src-gen
--macro metadata_segment.MetadataSegmentFixture.install('tests/metadata-segment/.tmp/plan.json')
--macro include('metadata_segment.positive')
