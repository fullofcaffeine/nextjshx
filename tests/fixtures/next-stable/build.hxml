-lib genes-ts
-cp src
-cp tests/fixtures/next-stable/haxe
-cp tests/fixtures/next-stable/.nextjshx/css-modules/haxe
--main FixtureMain

# genes-ts still compiles on Haxe's JavaScript platform. A .tsx entry selects
# split TypeScript/TSX output, and extensionless imports are owned by Next's
# bundler resolution.
-js tests/fixtures/next-stable/src-gen/index.tsx
-D genes.ts
-D genes.ts.no_extension
# React 19 exposes JSX from the module rather than as a global namespace.
-D genes.ts.jsx_import_source=react
-D nextjshx.app-root=tests/fixtures/next-stable/app
-D nextjshx.generated-root=tests/fixtures/next-stable/src-gen
-D nextjshx.adapter-plan-output=tests/fixtures/next-stable/.nextjshx/snapshot-plan.json
-D nextjshx_css_module_tracer

# Generated TypeScript adapters cannot make their Haxe modules enter the typed
# graph. Include the owning package; the declaration macro applies @:keep only
# to external entries while full DCE remains free to remove other declarations.
--macro next_stable.AdapterPlan.install()
--macro include('app')
--macro include('special_file_fixture')
--macro include('request_proxy_fixture')
-dce full
