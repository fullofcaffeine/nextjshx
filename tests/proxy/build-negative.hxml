-lib genes-ts
-cp src
-cp tests/proxy/src
-main proxy_fixture.NegativeRuntime
-js tests/proxy/.tmp/rejected.js
--no-output
-D genes.ts
-D genes.ts.no_extension
-D nextjshx.app-root=tests/proxy/next-app/app
-D nextjshx.generated-root=tests/proxy/.tmp/src-gen
--macro proxy_fixture.ProxyFixture.install('tests/proxy/.tmp/rejected.json')
--macro proxy_fixture.ProxyFixture.reject()
