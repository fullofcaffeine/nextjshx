-lib genes-ts
-cp src
-cp tests/proxy/src
-main proxy_fixture.NoRuntime
-js tests/proxy/.tmp/application.js
--no-output
-D genes.ts
-D genes.ts.no_extension
-D nextjshx.app-root=tests/proxy/next-app/app
-D nextjshx.generated-root=tests/proxy/.tmp/src-gen
--macro proxy_fixture.ProxyFixture.install('tests/proxy/.tmp/plan.json')
--macro include('proxy_fixture.positive')
