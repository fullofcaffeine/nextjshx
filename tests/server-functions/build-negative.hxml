--no-output
-D genes.ts
-D genes.ts.no_extension
-D nextjshx.app-root=tests/server-functions/next-app/app
-D nextjshx.generated-root=tests/server-functions/.tmp/generated
--macro server_functions_negative.Fixture.install()
--macro server_functions_negative.Fixture.reject()
