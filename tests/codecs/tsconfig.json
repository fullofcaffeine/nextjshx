{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "next"
    ],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    ".tmp/typescript/**/*.ts"
  ]
}
