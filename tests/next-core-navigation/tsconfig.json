{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    ".tmp/**/*.ts"
  ],
  "exclude": [
    ".tmp/invalid-metadata.ts",
    ".tmp/next_core_navigation/InvalidMetadataConsumer.ts"
  ]
}
