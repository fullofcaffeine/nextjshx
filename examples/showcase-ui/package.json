{
  "name": "@nextjshx/showcase-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "description": "Source-owned shadcn primitives and typed Haxe bindings shared by the NextJsHx showcases.",
  "type": "module",
