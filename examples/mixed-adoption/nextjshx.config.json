{
  "$schema": "https://nextjshx.dev/schemas/config-v2.json",
  "schemaVersion": 2,
  "appRoot": "app",
  "haxe": {
    "sourceRoots": [
      "haxe",
      "../showcase-ui/haxe"
    ],
    "generatedRoot": "src-gen"
  },
  "next": {
    "package": "next",
    "typedRoutes": true
  },
  "output": {
    "manifest": ".nextjshx/manifest.json",
    "format": "project",
    "language": "typescript",
    "intent": "reviewable",
    "profileVersion": 1,
    "sourceMaps": "external",
    "sourcesContent": true,
    "declarations": "public",
    "jsxRuntime": "automatic"
  }
}
