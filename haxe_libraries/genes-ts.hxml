# @install: lix --silent download "gh://github.com/fullofcaffeine/genes-ts#1ead794285d4f43cbbc96078d4eac4a4d8bf6cce" into genes-ts/1.41.0/github/1ead794285d4f43cbbc96078d4eac4a4d8bf6cce
-lib helder.set
-cp ${HAXE_LIBCACHE}/genes-ts/1.41.0/github/1ead794285d4f43cbbc96078d4eac4a4d8bf6cce/src
-D genes-ts=1.41.0
-D js-es=6
--macro genes.Generator.use()
--macro genes.js.Async.enable()
--macro genes.react.InlineMarkup.enable()
--macro addMetadata('@:genes.disableNativeAccessors', 'haxe.Exception')
