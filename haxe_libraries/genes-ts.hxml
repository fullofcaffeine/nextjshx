# @install: lix --silent download "gh://github.com/fullofcaffeine/genes-ts#f0ffa29e6d49fe81541977c6a3aae6b80000cec6" into genes-ts/1.38.2/github/f0ffa29e6d49fe81541977c6a3aae6b80000cec6
-lib helder.set
-cp ${HAXE_LIBCACHE}/genes-ts/1.38.2/github/f0ffa29e6d49fe81541977c6a3aae6b80000cec6/src
-D genes-ts=1.38.2
-D js-es=6
