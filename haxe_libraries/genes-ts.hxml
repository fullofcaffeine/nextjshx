# @install: lix --silent download "gh://github.com/fullofcaffeine/genes-ts#8a7f7aaf3227fdee79a3cbd25d90ef2c99975f78" into genes-ts/1.41.0/github/8a7f7aaf3227fdee79a3cbd25d90ef2c99975f78
-lib helder.set
-cp ${HAXE_LIBCACHE}/genes-ts/1.41.0/github/8a7f7aaf3227fdee79a3cbd25d90ef2c99975f78/src
-D genes-ts=1.41.0
-D js-es=6
--macro genes.Generator.use()
--macro genes.js.Async.enable()
--macro genes.react.InlineMarkup.enable()
--macro addMetadata('@:genes.disableNativeAccessors', 'haxe.Exception')
