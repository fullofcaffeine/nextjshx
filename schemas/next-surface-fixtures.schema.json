{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextjshx.dev/schemas/next-surface-fixtures-v1.json",
  "title": "NextJsHx public-surface fixture catalog",
  "description": "Named resolution evidence referenced by the reviewed Next.js public-entrypoint allowlist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/next-surface-fixtures.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "mode",
          "modules",
          "proves"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "mode": {
            "const": "typescript-declaration-resolution"
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proves": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    }
  }
}
