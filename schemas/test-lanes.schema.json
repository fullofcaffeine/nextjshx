{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextjshx.dev/schemas/test-lanes.schema.json",
  "title": "NextJsHx test lane and ownership manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "selectionMode",
    "confidenceWindow",
    "fullBackstops",
    "lanes"
  ],
  "properties": {
    "$schema": {
      "const": "https://nextjshx.dev/schemas/test-lanes.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "selectionMode": {
      "const": "observation"
    },
    "confidenceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumRuns",
        "minimumDays",
        "resetOnMiss"
      ],
      "properties": {
        "minimumRuns": {
          "type": "integer",
          "minimum": 30
        },
        "minimumDays": {
          "type": "integer",
          "minimum": 14
        },
        "resetOnMiss": {
          "const": true
        }
      }
    },
    "fullBackstops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main",
        "nightly",
        "release"
      ],
      "properties": {
        "main": {
          "const": true
        },
        "nightly": {
          "const": true
        },
        "release": {
          "const": true
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "bundler",
        "profile"
      ],
      "properties": {
        "node": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "bundler": {
          "type": "array",
          "items": {
            "enum": [
              "none",
              "turbopack",
              "webpack"
            ]
          },
          "uniqueItems": true
        },
        "profile": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "quarantine": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bead",
            "reason",
            "expires"
          ],
          "properties": {
            "bead": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "expires": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      ]
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "npmScript",
        "owners",
        "paths",
        "reverseDependencies",
        "evidence",
        "ring",
        "costClass",
        "alwaysRun",
        "environments",
        "mode",
        "timeoutSeconds",
        "mutatingRoots",
        "isolation",
        "preparation",
        "artifacts",
        "reproduction",
        "claimStatus",
        "groups",
        "hook",
        "expansion",
        "quarantine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "npmScript": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:.-]*$"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reverseDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "architecture",
              "browser",
              "clean-consumer",
              "cli",
              "compatibility",
              "determinism",
              "governance",
              "haxe-negative",
              "haxe-positive",
              "next-build",
              "ownership",
              "package-drift",
              "react-lint",
              "runtime",
              "security",
              "snapshot",
              "strict-typescript",
              "test-topology"
            ]
          },
          "uniqueItems": true
        },
        "ring": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "costClass": {
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "xlarge"
          ]
        },
        "alwaysRun": {
          "type": "boolean"
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "mode": {
          "enum": [
            "clean",
            "warm",
            "clean-and-warm"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "mutatingRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "isolation": {
          "enum": [
            "shared-readonly",
            "exclusive-worktree",
            "isolated-process"
          ]
        },
        "preparation": {
          "type": "array",
          "items": {
            "enum": [
              "browser",
              "cli-runtime",
              "cli-test",
              "haxe-libraries",
              "locked-npm",
              "none"
            ]
          },
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reproduction": {
          "type": "string",
          "pattern": "^npm run "
        },
        "claimStatus": {
          "enum": [
            "required",
            "advisory",
            "internal"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "enum": [
              "harness",
              "main",
              "nightly",
              "pr-primary",
              "release",
              "smoke"
            ]
          },
          "uniqueItems": true
        },
        "hook": {
          "type": "boolean"
        },
        "expansion": {
          "enum": [
            "none",
            "full"
          ]
        },
        "quarantine": {
          "$ref": "#/$defs/quarantine"
        }
      }
    }
  }
}
