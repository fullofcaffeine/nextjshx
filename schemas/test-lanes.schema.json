{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextjshx.dev/schemas/test-lanes.schema.json",
  "title": "NextJsHx test lane and ownership manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "selectionMode",
    "confidenceWindow",
    "fullBackstops",
    "productSurfaces",
    "examples",
    "lanes"
  ],
  "properties": {
    "$schema": {
      "const": "https://nextjshx.dev/schemas/test-lanes.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "selectionMode": {
      "const": "observation"
    },
    "confidenceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumRuns",
        "minimumDays",
        "resetOnMiss"
      ],
      "properties": {
        "minimumRuns": {
          "type": "integer",
          "minimum": 30
        },
        "minimumDays": {
          "type": "integer",
          "minimum": 14
        },
        "resetOnMiss": {
          "const": true
        }
      }
    },
    "fullBackstops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main",
        "nightly",
        "release"
      ],
      "properties": {
        "main": {
          "const": true
        },
        "nightly": {
          "const": true
        },
        "release": {
          "const": true
        }
      }
    },
    "productSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/productSurface"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    }
  },
  "$defs": {
    "evidence": {
      "enum": [
        "architecture",
        "browser",
        "clean-consumer",
        "cli",
        "compatibility",
        "determinism",
        "governance",
        "haxe-negative",
        "haxe-positive",
        "next-build",
        "ownership",
        "package-drift",
        "react-lint",
        "runtime",
        "security",
        "snapshot",
        "strict-typescript",
        "test-topology"
      ]
    },
    "laneIds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
      "uniqueItems": true
    },
    "evidenceOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "laneIds"],
      "properties": {
        "evidence": {"$ref": "#/$defs/evidence"},
        "laneIds": {"$ref": "#/$defs/laneIds"}
      }
    },
    "profileOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "laneIds"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "laneIds": {"$ref": "#/$defs/laneIds"}
      }
    },
    "lastCleanProof": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "runId", "command", "completedAt", "resultArtifact", "resultDigest"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "runId": {"type": "string", "minLength": 1},
            "command": {"type": "string", "pattern": "^npm run "},
            "completedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
            "resultArtifact": {"type": "string", "minLength": 1},
            "resultDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "pin"
      ],
      "properties": {
        "kind": {
          "enum": [
            "specification",
            "manual-expectation",
            "pinned-differential",
            "invariant",
            "reviewed-golden",
            "real-consumer"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "pin": {
          "type": ["string", "null"]
        }
      }
    },
    "productSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "owner",
        "archetype",
        "status",
        "claims",
        "authoredInputs",
        "producedOutputs",
        "supportedProfiles",
        "testedProfiles",
        "profileOwners",
        "requiredEvidence",
        "evidenceOwners",
        "laneIds",
        "focusedOwners",
        "verticalIntegrationOwners",
        "realRuntimeOrSystemOwners",
        "browserE2EOwners",
        "examples",
        "oracles",
        "adaptations",
        "knownSkips",
        "quarantines",
        "selectorOwnership",
        "fullBackstopCommand",
        "releaseCommand",
        "lastCleanProof",
        "residualRisks",
        "knownLimitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "enum": [
            "compiler",
            "native-metal",
            "runtime-stdlib",
            "framework",
            "browser-app",
            "package-cli",
            "migration",
            "bootstrap",
            "diagnostics",
            "security",
            "performance",
            "portability"
          ]
        },
        "status": {
          "enum": ["experimental", "admitted-slice", "partial", "qualified", "release-claiming"]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "authoredInputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "producedOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "supportedProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "testedProfiles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "profileOwners": {
          "type": "array",
          "items": {"$ref": "#/$defs/profileOwner"}
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"},
          "uniqueItems": true
        },
        "evidenceOwners": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceOwner"}
        },
        "laneIds": {
          "$ref": "#/$defs/laneIds"
        },
        "focusedOwners": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "verticalIntegrationOwners": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "realRuntimeOrSystemOwners": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "browserE2EOwners": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "oracles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/oracle"}
        },
        "adaptations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "knownSkips": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "quarantines": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "selectorOwnership": {
          "type": "string",
          "minLength": 1
        },
        "fullBackstopCommand": {
          "type": "string",
          "pattern": "^npm run "
        },
        "releaseCommand": {
          "type": "string",
          "pattern": "^npm run "
        },
        "lastCleanProof": {
          "$ref": "#/$defs/lastCleanProof"
        },
        "residualRisks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "knownLimitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "tier",
        "distinctiveClaims",
        "supportedProfiles",
        "laneIds",
        "advertisedEvidence",
        "evidenceOwners",
        "knownLimitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^examples/[A-Za-z0-9._-]+$"
        },
        "tier": {
          "enum": ["flagship-application", "capability-showcase", "compile-only-snippet"]
        },
        "distinctiveClaims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "supportedProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "laneIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "advertisedEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"},
          "uniqueItems": true
        },
        "evidenceOwners": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceOwner"}
        },
        "knownLimitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "bundler",
        "profile"
      ],
      "properties": {
        "node": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "bundler": {
          "type": "array",
          "items": {
            "enum": [
              "none",
              "turbopack",
              "webpack"
            ]
          },
          "uniqueItems": true
        },
        "profile": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "quarantine": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bead",
            "reason",
            "expires"
          ],
          "properties": {
            "bead": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "expires": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      ]
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "npmScript",
        "owners",
        "paths",
        "reverseDependencies",
        "evidence",
        "surfaceIds",
        "exampleIds",
        "ring",
        "costClass",
        "alwaysRun",
        "environments",
        "mode",
        "timeoutSeconds",
        "mutatingRoots",
        "isolation",
        "preparation",
        "artifacts",
        "reproduction",
        "claimStatus",
        "groups",
        "hook",
        "expansion",
        "quarantine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "npmScript": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:.-]*$"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reverseDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"},
          "uniqueItems": true
        },
        "surfaceIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "exampleIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "uniqueItems": true
        },
        "ring": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "costClass": {
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "xlarge"
          ]
        },
        "alwaysRun": {
          "type": "boolean"
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "mode": {
          "enum": [
            "clean",
            "warm",
            "clean-and-warm"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "mutatingRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "isolation": {
          "enum": [
            "shared-readonly",
            "exclusive-worktree",
            "isolated-process"
          ]
        },
        "preparation": {
          "type": "array",
          "items": {
            "enum": [
              "browser",
              "cli-runtime",
              "cli-test",
              "haxe-libraries",
              "locked-npm",
              "none"
            ]
          },
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reproduction": {
          "type": "string",
          "pattern": "^npm run "
        },
        "claimStatus": {
          "enum": [
            "required",
            "advisory",
            "internal"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "enum": [
              "harness",
              "main",
              "nightly",
              "pr-primary",
              "release",
              "smoke"
            ]
          },
          "uniqueItems": true
        },
        "hook": {
          "type": "boolean"
        },
        "expansion": {
          "enum": [
            "none",
            "full"
          ]
        },
        "quarantine": {
          "$ref": "#/$defs/quarantine"
        }
      }
    }
  }
}
