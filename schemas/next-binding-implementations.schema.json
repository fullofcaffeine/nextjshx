{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextjshx.dev/schemas/next-binding-implementations-v1.json",
  "title": "NextJsHx curated binding implementations",
  "description": "Signature-pinned groups of reviewed handwritten Haxe externs and their strict parity fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reviewedSurfaceHash",
    "implementations"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/next-binding-implementations.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "reviewedSurfaceHash": {
      "$ref": "#/$defs/digest"
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/implementation"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bead": {
      "type": "string",
      "pattern": "^nxhx-[a-z0-9]+(?:\\.[0-9]+)*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export",
        "expectedSignatureHash"
      ],
      "properties": {
        "export": {
          "type": "string",
          "minLength": 1
        },
        "expectedSignatureHash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "strategy",
        "symbols",
        "outputs",
        "fixture",
        "owningBead",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "enum": [
            "curated-public-module-extern",
            "curated-public-type-projection"
          ]
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portablePath"
          }
        },
        "fixture": {
          "$ref": "#/$defs/portablePath"
        },
        "owningBead": {
          "$ref": "#/$defs/bead"
        },
        "reason": {
          "type": "string",
          "minLength": 40
        }
      }
    }
  }
}
